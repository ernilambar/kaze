<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="kaze"
        Arguments=""
        InstallLocation="C:\Program Files\Nilambar Sharma\Kaze">
    </Installer>
    <PackageInformation
        PackageName="Kaze"
        PackageDisplayName="Kaze"
        PublisherName="CN=Nilambar Sharma"
        PublisherDisplayName="Nilambar Sharma"
        Version="0.1.0.0"
        PackageDescription="A simple text editor.">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="net.nilambar.kaze"
                Description="A simple text editor."
                DisplayName="Kaze"
                ExecutableName="kaze"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Kaze</DisplayName>
            <PublisherDisplayName>Nilambar Sharma</PublisherDisplayName>
            <Description>A simple text editor.</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="kaze.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
