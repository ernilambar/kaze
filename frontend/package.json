{
  "name": "frontend",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "build": "pnpm run check && vite build",
    "build:dev": "vite build --minify false --mode development",
    "preview": "vite preview",
    "test": "vitest run",
