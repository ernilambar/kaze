  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "happy-dom": "^21.0.4",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@wailsio/runtime": "3.1.0",
    "monaco-editor": "^0.57.0",
    "svelte": "^5.57.3"
  }
}
